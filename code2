// ==================================================
// SPEED CONSTANTS
// ==================================================
const int SPD_BASE    = 140;
const int SPD_BOTTOM  = 85;
const int SPD_TOP     = 205;
const int SPD_ROTATE  = 130;
int       manualSpeed = 120;

// ==================================================
// CORRECTION STEPS
// ==================================================
const int STEP_1 = 70;
const int STEP_2 = 75;
const int STEP_3 = 80;
const int STEP_4 = 85;

// ==================================================
// TIMING CONSTANTS
// ==================================================
const unsigned long T_BRAKE      = 35;
const unsigned long T_SETTLE     = 600;
const unsigned long T_CREEP_JCT  = 510;
const unsigned long T_CREEP_PEEK = 150;
const unsigned long T_SPIN_MIN   = 500;
const unsigned long T_SCAN_MAX   = 1700;
const unsigned long T_CONFIRM    = 45;
const unsigned long T_LINELOST   = 220;
const unsigned long T_GOALCHECK  = 250;
const unsigned long T_LOCKOUT    = 220;

// ==================================================
// STATE
// ==================================================
int           gLastErr = 0;
unsigned long gLockEnd = 0;
bool          goalReached = false;
int robotMode = 1; // 1=waitStart 2=training 3=waitBack 4=solving 5=done

